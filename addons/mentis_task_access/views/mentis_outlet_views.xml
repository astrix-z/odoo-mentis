<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mentis_outlet_view_tree" model="ir.ui.view">
        <field name="name">mentis.outlet.tree</field>
        <field name="model">mentis.outlet</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="network_id"/>
                <field name="manager_ids" widget="many2many_avatar_user"/>
                <field name="service_user_ids" widget="many2many_avatar_user"/>
                <field name="accounting_user_ids" widget="many2many_avatar_user"/>
            </tree>
        </field>
    </record>

    <record id="mentis_outlet_view_form" model="ir.ui.view">
        <field name="name">mentis.outlet.form</field>
        <field name="model">mentis.outlet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="network_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="manager_ids" widget="many2many_avatar_user"/>
                            <field name="service_user_ids" widget="many2many_avatar_user"/>
                            <field name="accounting_user_ids" widget="many2many_avatar_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mentis_outlet_view_search" model="ir.ui.view">
        <field name="name">mentis.outlet.search</field>
        <field name="model">mentis.outlet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="network_id"/>
                <field name="manager_ids"/>
                <field name="service_user_ids"/>
                <field name="accounting_user_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Network" name="groupby_network" context="{'group_by': 'network_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mentis_outlet_action" model="ir.actions.act_window">
        <field name="name">Outlets</field>
        <field name="res_model">mentis.outlet</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_groupby_network': 1}</field>
    </record>

</odoo>
