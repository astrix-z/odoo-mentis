<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_mentis_tasks" model="ir.module.category">
        <field name="name">Mentis Tasks</field>
        <field name="description">Task visibility by network, outlet and department.</field>
        <field name="sequence">46</field>
    </record>

    <record id="group_executive" model="res.groups">
        <field name="name">Executive: all tasks</field>
        <field name="category_id" ref="module_category_mentis_tasks"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_network_manager" model="res.groups">
        <field name="name">Network Manager: tasks of managed networks</field>
        <field name="category_id" ref="module_category_mentis_tasks"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_outlet_manager" model="res.groups">
        <field name="name">Outlet Manager: tasks of managed outlets</field>
        <field name="category_id" ref="module_category_mentis_tasks"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_it" model="res.groups">
        <field name="name">IT: IT queue tasks</field>
        <field name="category_id" ref="module_category_mentis_tasks"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_service" model="res.groups">
        <field name="name">Service: service tasks of own outlets</field>
        <field name="category_id" ref="module_category_mentis_tasks"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <record id="group_accounting" model="res.groups">
        <field name="name">Accounting: accounting tasks of own outlets</field>
        <field name="category_id" ref="module_category_mentis_tasks"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <!--
        Record rules of different groups are OR-ed, and Odoo's own rules still apply:
        every employee also sees tasks they are assigned to or follow, and all tasks of
        projects they follow or whose visibility is not "Invited internal users".
    -->

    <!-- Tasks -->
    <record id="task_rule_executive" model="ir.rule">
        <field name="name">Mentis Task: executive sees all</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_executive'))]"/>
    </record>
    <record id="task_rule_network_manager" model="ir.rule">
        <field name="name">Mentis Task: network manager sees managed networks and tasks scoped to them</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', '|',
            ('mentis_network_id.manager_ids', 'in', user.id),
            ('mentis_scope_network_ids.manager_ids', 'in', user.id),
            ('mentis_scope_outlet_ids.network_id.manager_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_network_manager'))]"/>
    </record>
    <record id="task_rule_outlet_manager" model="ir.rule">
        <field name="name">Mentis Task: outlet manager sees managed outlets</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('mentis_outlet_id.manager_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_outlet_manager'))]"/>
    </record>
    <record id="task_rule_it" model="ir.rule">
        <field name="name">Mentis Task: IT sees IT queue</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'it')]</field>
        <field name="groups" eval="[(4, ref('group_it'))]"/>
    </record>
    <record id="task_rule_service" model="ir.rule">
        <field name="name">Mentis Task: service sees service queue of own outlets</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'service'), ('mentis_outlet_id.service_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_service'))]"/>
    </record>
    <record id="task_rule_accounting" model="ir.rule">
        <field name="name">Mentis Task: accounting sees accounting queue of own outlets</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'accounting'), ('mentis_outlet_id.accounting_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_accounting'))]"/>
    </record>

    <!-- Task analysis report -->
    <record id="report_task_rule_executive" model="ir.rule">
        <field name="name">Mentis Task Analysis: executive sees all</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_executive'))]"/>
    </record>
    <record id="report_task_rule_network_manager" model="ir.rule">
        <field name="name">Mentis Task Analysis: network manager sees managed networks and tasks scoped to them</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">['|', '|',
            ('task_id.mentis_network_id.manager_ids', 'in', user.id),
            ('task_id.mentis_scope_network_ids.manager_ids', 'in', user.id),
            ('task_id.mentis_scope_outlet_ids.network_id.manager_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_network_manager'))]"/>
    </record>
    <record id="report_task_rule_outlet_manager" model="ir.rule">
        <field name="name">Mentis Task Analysis: outlet manager sees managed outlets</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[('task_id.mentis_outlet_id.manager_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_outlet_manager'))]"/>
    </record>
    <record id="report_task_rule_it" model="ir.rule">
        <field name="name">Mentis Task Analysis: IT sees IT queue</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'it')]</field>
        <field name="groups" eval="[(4, ref('group_it'))]"/>
    </record>
    <record id="report_task_rule_service" model="ir.rule">
        <field name="name">Mentis Task Analysis: service sees service queue of own outlets</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'service'), ('task_id.mentis_outlet_id.service_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_service'))]"/>
    </record>
    <record id="report_task_rule_accounting" model="ir.rule">
        <field name="name">Mentis Task Analysis: accounting sees accounting queue of own outlets</field>
        <field name="model_id" ref="project.model_report_project_task_user"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'accounting'), ('task_id.mentis_outlet_id.accounting_user_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_accounting'))]"/>
    </record>

    <!-- Burndown chart has no task link, so only queue-wide roles get it -->
    <record id="burndown_rule_executive" model="ir.rule">
        <field name="name">Mentis Burndown: executive sees all</field>
        <field name="model_id" ref="project.model_project_task_burndown_chart_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_executive'))]"/>
    </record>
    <record id="burndown_rule_it" model="ir.rule">
        <field name="name">Mentis Burndown: IT sees IT queue</field>
        <field name="model_id" ref="project.model_project_task_burndown_chart_report"/>
        <field name="domain_force">[('project_id.mentis_queue', '=', 'it')]</field>
        <field name="groups" eval="[(4, ref('group_it'))]"/>
    </record>

    <!-- Projects: queue projects are visible to every role so its tasks can be opened and created -->
    <record id="project_rule_executive" model="ir.rule">
        <field name="name">Mentis Project: executive sees all</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_executive'))]"/>
    </record>
    <record id="project_rule_queue" model="ir.rule">
        <field name="name">Mentis Project: roles see department queue projects</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('mentis_queue', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_network_manager')), (4, ref('group_outlet_manager')), (4, ref('group_it')), (4, ref('group_service')), (4, ref('group_accounting'))]"/>
    </record>
    <record id="project_update_rule_executive" model="ir.rule">
        <field name="name">Mentis Project Update: executive sees all</field>
        <field name="model_id" ref="project.model_project_update"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_executive'))]"/>
    </record>
    <record id="project_milestone_rule_executive" model="ir.rule">
        <field name="name">Mentis Project Milestone: executive sees all</field>
        <field name="model_id" ref="project.model_project_milestone"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_executive'))]"/>
    </record>

</odoo>
